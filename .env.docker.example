# Docker Compose environment overrides
# Copy relevant values into your existing .env, or export them before running `docker compose up`.
# These are separate from DB_USERNAME/DB_PASSWORD in .env (which may be "root" for local dev)
# to avoid conflicting with the official MySQL image restrictions.

APP_PORT=8000
REVERB_PORT=8080
DB_FORWARD_PORT=3307
REDIS_FORWARD_PORT=6379

MYSQL_DATABASE=kref
MYSQL_APP_USER=kref
MYSQL_APP_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret

WAHA_PORT=3000
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=PasswordRahasiaKamu123!
WAHA_API_KEY=APIKeyRahasiaKamu123!
WAHA_SESSION=kref
